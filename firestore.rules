rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt']) && data.keys().size() <= 2
        && data.email is string && data.email.size() <= 128
        && data.createdAt is number;
    }
    
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().email == request.auth.token.email;
      
      allow update: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([]) 
        && incoming().createdAt == existing().createdAt;
    }

    // Children
    function isValidChildCreate(data) {
      return data.keys().hasAll(['name', 'expirationDate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 5 && data.keys().size() <= 8
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && (data.get('photoUrl', '') is string) && (data.get('photoUrl', '').size() <= 204800)
        && (data.get('notes', '') is string) && (data.get('notes', '').size() <= 2048)
        && (data.get('isLost', false) is bool)
        && data.expirationDate is number
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.createdAt is number
        && data.updatedAt is number;
    }
    
    function isValidChildUpdate(data) {
      return data.keys().hasAll(['name', 'expirationDate', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 5 && data.keys().size() <= 8
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && (data.get('photoUrl', '') is string) && (data.get('photoUrl', '').size() <= 204800)
        && (data.get('notes', '') is string) && (data.get('notes', '').size() <= 2048)
        && (data.get('isLost', false) is bool)
        && data.expirationDate is number
        && data.ownerId is string && data.ownerId == request.auth.uid
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /children/{childId} {
      allow get: if isSignedIn() && isValidId(childId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(childId)
        && isValidChildCreate(incoming());
        
      allow update: if isSignedIn()
        && isValidId(childId)
        && existing().ownerId == request.auth.uid
        && isValidChildUpdate(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'expirationDate', 'notes', 'isLost', 'updatedAt']);
        
      allow delete: if isSignedIn() && isValidId(childId) && existing().ownerId == request.auth.uid;
    }
  }
}
